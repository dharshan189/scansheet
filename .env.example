# ============================================================================
# ScanSheet - Environment Configuration Template
# Copy this file to .env locally and set values in Vercel Project Settings.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE PUBLIC CREDENTIALS (Safe for Frontend & /api/config)
# Supports either NEXT_PUBLIC_* (Supabase/Vercel default) or SUPABASE_* names
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternative legacy names also supported:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Service Role Key (NEVER expose in frontend code or commit to Git!)
# SUPABASE_SERVICE_ROLE_KEY=...

# ----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONNECTIONS & CONNECTION POOLING
# ----------------------------------------------------------------------------
# TRANSACTION POOLER (Port 6543) - Recommended for serverless environments (Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT SESSION CONNECTION (Port 5432) - For direct psql / CLI migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ----------------------------------------------------------------------------
# 3. PADDLEOCR BACKEND CONFIGURATION
# ----------------------------------------------------------------------------
PORT=8080
OCR_PORT=5000
# Optional URL when deploying Python OCR service externally (Railway/Render/VPS):
# OCR_SERVER_URL=https://your-paddleocr-service.up.railway.app
